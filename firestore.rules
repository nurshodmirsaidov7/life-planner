rules_version = '2';
// Each signed-in person can read and write only their own data: users/{uid} and users/{uid}/lists/{list}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /lists/{list} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
